// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int       @id @default(autoincrement()) // Khóa chính tự tăng
  email     String    @unique // Email là duy nhất
  name      String
  password  String // Mật khẩu dạng hash
  createdAt DateTime  @default(now())
  invoices  Invoice[] // Mối quan hệ: Một user có nhiều hóa đơn
}

model Invoice {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  status    String   @default("UNPAID")
  imageUrl  String? // Thêm dấu ? nghĩa là cột này có thể null (không bắt buộc)
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])
}
